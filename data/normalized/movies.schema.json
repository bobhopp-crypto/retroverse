{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retroverse.local/schemas/movies.schema.json",
  "title": "RetroVerse normalized movie",
  "type": "object",
  "required": ["title", "year", "sources"],
  "properties": {
    "title": { "type": "string" },
    "original_title": { "type": ["string", "null"] },
    "year": { "type": "integer" },
    "release_date": { "type": ["string", "null"] },
    "medium": { "type": ["string", "null"] },
    "genres": {
      "type": "array",
      "items": { "type": "string" }
    },
    "runtime_minutes": { "type": ["integer", "null"] },
    "source_ids": {
      "type": "object",
      "properties": {
        "tmdb_id": { "type": ["integer", "null"] },
        "imdb_id": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_system"],
        "properties": {
          "source_system": {
            "type": "string",
            "enum": ["screen_culture_warehouse", "imdb_tsv", "tmdb_api", "omdb_api", "year_master", "other"]
          },
          "source_path": { "type": ["string", "null"] },
          "provenance": { "type": ["array", "null"], "items": { "type": "object", "additionalProperties": true } }
        },
        "additionalProperties": true
      }
    },
    "raw_record": {
      "type": ["object", "null"],
      "description": "Optional passthrough of warehouse payload for fields not mapped here."
    }
  },
  "additionalProperties": true
}
