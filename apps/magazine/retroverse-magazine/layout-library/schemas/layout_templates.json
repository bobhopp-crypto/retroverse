{
  "library_name": "RetroVerse Layout Library",
  "version": "1.0.0",
  "templates": [
    {
      "template_id": "cover_page",
      "name": "Cover Page",
      "description": "Hero-first issue opener with masthead priority and selective cover lines.",
      "page_type": "cover",
      "recommended_content": [
        "issue title",
        "year marker",
        "cover lines",
        "hero illustration"
      ],
      "required_blocks": [
        "masthead",
        "headline",
        "subhead",
        "hero_image",
        "caption",
        "footer_nav",
        "page_number"
      ],
      "optional_blocks": [
        "artifact_tile",
        "sidebar_box",
        "pull_quote",
        "byline"
      ],
      "text_weight": "low",
      "visual_weight": "very_high",
      "preferred_illustrator_types": [
        "hand-ink editorial",
        "watercolor wash",
        "poster-style collage"
      ],
      "notes": "Use for first page only. Keep copy short and high impact. Render the official masthead as 'RetroVerse' with 'Press ▶ Play for the Past' beneath it, above the year marker."
    },
